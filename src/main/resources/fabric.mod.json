	"authors": [
		"Alfix"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/more-endgame",
		"sources": "https://github.com/Alfix-Januarivinter/MoreEndgame",
		"issues": "https://github.com/Alfix-Januarivinter/MoreEndgame/issues"
	},
	"license": "CC-BY-SA-4.0",
	"icon": "assets/moreendgame/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.alfixjanuarivinter.moreendgame.MoreEndgame"
		],
		"client": [
			"com.alfixjanuarivinter.moreendgame.client.MoreEndgameClient"
		],
		"fabric-datagen": [
			"com.alfixjanuarivinter.moreendgame.client.MoreEndgameDataGenerator"
		]
	},
	"mixins": [
