	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.com/invite/ETTr37p38R",
				"modmenu.github_releases" : "https://github.com/Alfix-Januarivinter/MoreEndgame/releases",
				"modmenu.modrinth" : "https://modrinth.com/mod/more-endgame"
			},
			"badges": [ "adventure", "equipment", "magic", "utility" ],
			"update_checker": true
		}
	},
	"depends": {
		"fabricloader": ">=0.19.3",
